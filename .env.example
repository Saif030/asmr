# ---------------------------------------------------------------------------
# Khatmal Coaching — environment variables
#
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# In Vercel: Project → Settings → Environment Variables → add the same keys.
# ---------------------------------------------------------------------------

# Appwrite API endpoint — Appwrite Console → Project Overview → Endpoint
# Example: https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"

# Appwrite project id — Appwrite Console → Project Overview → Project ID
NEXT_PUBLIC_APPWRITE_PROJECT_ID="6a42bfda0033e1bb78a5"

# Server API key — Appwrite Console → Project Overview → Integrations → API Keys
# Create one with these scopes:
#   databases.read, databases.write, tables.read, tables.write,
#   files.read, files.write, teams.read, teams.write,
#   users.read, users.write, sessions.write
# NEVER expose this to the browser.
APPWRITE_API_KEY="standard_bd50efc895094c32808e749bf0d1dba70774594af808e62038871eddbdec1d99cc0af34880628d003e627b7f2e175c887ad9c1367d0e4c4c6411f2ee66b7e1ae02540596a33a1f738eeffff6800742d115681324f78f90d845532fc726d9cac6d53919625ec7483432d6106a35bf465dade7692015814f225790559c5b8b08a2"

# The shared invite code members must enter to sign up.
# Keep this server-only (no NEXT_PUBLIC_ prefix) so it is never exposed.
INVITE_CODE=khatmal

# Optional. The id of the database the setup script creates.
# Defaults to "khatmal" if you leave it out.
NEXT_PUBLIC_APPWRITE_DATABASE_ID=6ad7639c00341cfad2ea

# Optional. Storage bucket ids created by the setup script.
NEXT_PUBLIC_APPWRITE_BUCKET_MATERIALS=materials
NEXT_PUBLIC_APPWRITE_BUCKET_CHAT=chat-images

# Optional. The team whose members are admins. The first account joins it.
APPWRITE_ADMIN_TEAM_ID=admins

# Optional. Storage ceiling in bytes. Defaults to 150 GB (the Appwrite
# Education plan). Lower it if you are on the Free plan (2 GB → 2147483648).
# APPWRITE_STORAGE_LIMIT_BYTES=161061273600

# Optional. The public URL of the deployment, used to show the keepalive URL
# on the admin page. Example: https://khatmal-coaching.vercel.app
NEXT_PUBLIC_APP_URL=
